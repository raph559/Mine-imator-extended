				}
			}
			break
		}

		case "color":
		{
			if (string_length(val) > 7)
			{
				from = hex_to_color(string_copy(val, 1, 7))
				to = hex_to_color(string_copy(val, 10, 7))
				if (!(p.color_israndom > 0))
					action_lib_pc_type_color_israndom(true)
				if (p.color_random_start != from)
					action_lib_pc_type_color_random_start(from)
				if (p.color_random_end != to)
					action_lib_pc_type_color_random_end(to)
			}
			else
			{
				from = hex_to_color(string(val))
				if (p.color_israndom > 0)
					action_lib_pc_type_color_israndom(false)
