/// bridge_number_error(name, value)
/// @arg name
/// @arg value
/// @desc Checks the plain number settings of a particle type.

function bridge_number_error(name, val)
{
	if (!is_real(val) || is_bool(val))
		return string(name) + " must be a number"

	if (name = "bounce_factor")
	{
		if (val < 0 || val > 10)
			return "bounce_factor must be a number from 0 to 10"
		return ""
	}

	if (name = "sprite_frame_width")
	{
		if (val < 1 || val > 4096 || val != round(val))
			return "sprite_frame_width must be a whole number from 1 to 4096"
		return ""
	}

	if (name = "sprite_frame_height")
	{
		if (val < 1 || val > 4096 || val != round(val))
			return "sprite_frame_height must be a whole number from 1 to 4096"
		return ""
	}

	if (name = "sprite_frame_start")
	{
		if (val < 0 || val > 4096 || val != round(val))
			return "sprite_frame_start must be a whole number from 0 to 4096"
		return ""
	}

	if (name = "sprite_frame_end")
	{
		if (val < 0 || val > 4096 || val != round(val))
			return "sprite_frame_end must be a whole number from 0 to 4096"
		return ""
	}

	return ""
}

